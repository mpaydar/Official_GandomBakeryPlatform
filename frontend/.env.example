# Neon on Vercel — run: vercel env pull .env.local

# Pooled (app runtime on Vercel)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Direct (npm run db:migrate only — no -pooler in host)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="${DATABASE_URL_UNPOOLED}"

JWT_SECRET_KEY="change-me-to-a-long-random-string"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES="10080"
